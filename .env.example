# Copier ce fichier en .env (jamais commite) et renseigner votre chaine de connexion
# Supabase reelle : Project Settings > Database > Connection string > URI
# (utiliser le mode "Session pooler" ou "Transaction pooler" recommande par Supabase
# pour les connexions depuis un environnement serverless comme Streamlit Cloud)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@VOTRE_PROJET.supabase.co:5432/postgres
